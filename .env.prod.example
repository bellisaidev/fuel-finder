SPRING_PROFILES_ACTIVE=prod
FUEL_FINDER_CLIENT_ID=<client-id>
FUEL_FINDER_CLIENT_SECRET=<client-secret>
SPRING_DATASOURCE_URL=jdbc:postgresql://<database-host>:5432/<database-name>
SPRING_DATASOURCE_USERNAME=<database-user>
SPRING_DATASOURCE_PASSWORD=<database-password>

# Optional HTTP resilience overrides. Defaults are shown; uncomment only when tuning is required.
# FUELFINDER_API_HTTP_CONNECT_TIMEOUT=5s
# FUELFINDER_API_HTTP_RESPONSE_TIMEOUT=20s
# FUELFINDER_API_HTTP_POOL_MAX_CONNECTIONS=20
# FUELFINDER_API_HTTP_POOL_PENDING_ACQUIRE_MAX_COUNT=40
# FUELFINDER_API_HTTP_POOL_PENDING_ACQUIRE_TIMEOUT=5s
# FUELFINDER_API_HTTP_POOL_MAX_IDLE_TIME=30s
# FUELFINDER_API_HTTP_POOL_MAX_LIFE_TIME=5m
# FUELFINDER_API_HTTP_POOL_EVICTION_INTERVAL=30s
# FUELFINDER_API_HTTP_RETRY_MAX_RETRIES=2
# FUELFINDER_API_HTTP_RETRY_INITIAL_BACKOFF=500ms
# FUELFINDER_API_HTTP_RETRY_MAX_BACKOFF=5s
# FUELFINDER_API_HTTP_RETRY_JITTER=0.5
# FUELFINDER_API_HTTP_RETRY_MAX_RETRY_AFTER=30s
